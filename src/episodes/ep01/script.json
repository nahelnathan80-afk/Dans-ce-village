{
  "id": "ep01",
  "title": "Dans ce village, chaque mot prononcé coûte 1 €",
  "startBalance": 15,
  "payer": "leon",
  "voices": {
    "vo":    {"engine": "chatterbox", "exaggeration": 0.75, "cfg": 0.4, "tempo": 1.05, "seed": 7},
    "leon":  {"engine": "chatterbox", "exaggeration": 0.95, "cfg": 0.35, "seed": 11, "gain": 1.2},
    "kevin": {"engine": "chatterbox", "ref": "tools/voices/ref-kevin.wav", "exaggeration": 0.9, "cfg": 0.35, "seed": 3, "gain": 1.1},
    "maire": {"engine": "chatterbox", "ref": "tools/voices/ref-maire.wav", "exaggeration": 0.8, "cfg": 0.4, "seed": 5, "gain": 1.1}
  },
  "lines": [
    {"id": "hook-courez", "who": "leon", "text": "COUREZ !", "say": "Courez !", "paid": true, "balanceBefore": 14, "pause": 0.17},
    {"id": "hook-1", "who": "vo", "text": "Dans mon village, chaque mot coûte un euro.", "pause": 0.1},
    {"id": "hook-2", "who": "vo", "text": "Et moi, il me reste quinze euros.", "speed": 0.85, "balanceBefore": 15, "pause": 0.14},
    {"id": "rewind", "who": "vo", "text": "Attends… je reprends depuis le début.", "pause": 0.24},
    {"id": "maire-1", "who": "vo", "text": "Le maire fait tous ses discours en mime.", "pause": 0.1},
    {"id": "maire-2", "who": "vo", "text": "La dernière fois, il a mimé « budget ».", "pause": 0.14},
    {"id": "maire-3", "who": "vo", "text": "On a cru qu'il se noyait.", "pause": 0.28},
    {"id": "boul-1", "who": "vo", "text": "La boulangère vend tout avec des pancartes.", "pause": 0.14},
    {"id": "boul-2", "who": "vo", "text": "Baguette.", "pause": 0.17},
    {"id": "boul-3", "who": "vo", "text": "Croissant.", "pause": 0.17},
    {"id": "boul-4", "who": "vo", "text": "On ne fait pas crédit.", "pause": 0.28},
    {"id": "amour-1", "who": "vo", "text": "Les amoureux se parlent en morse, avec des lampes de poche.", "pause": 0.1},
    {"id": "amour-2", "who": "vo", "text": "Ça fait trois ans qu'ils essaient de se dire « je t'aime ».", "pause": 0.21},
    {"id": "amour-3", "who": "vo", "text": "Ils en sont au J.", "pause": 0.35},
    {"id": "kevin-1", "who": "vo", "text": "Et puis, il y a Kevin.", "pause": 0.07},
    {"id": "kevin-2", "who": "vo", "text": "Kevin a dit bonjour… à la montagne.", "pause": 0.14},
    {"id": "kevin-bonjour", "who": "kevin", "text": "Bonjour !", "paid": true, "payer": "kevin", "pause": 0.07},
    {"id": "kevin-echo", "who": "echo", "of": "kevin-bonjour", "text": "bonjour…", "repeats": 3, "gap": 0.42, "paid": true, "payer": "kevin", "pause": 0.14},
    {"id": "kevin-3", "who": "vo", "text": "L'écho, ça se paie aussi.", "pause": 0.28},
    {"id": "pense-1", "who": "vo", "text": "Moi, je parle surtout dans ma tête.", "pause": 0.07},
    {"id": "pense-2", "who": "vo", "text": "Penser, c'est gratuit.", "pause": 0.35},
    {"id": "four-1", "who": "vo", "text": "Ce matin, je suis seul à la boulangerie.", "pause": 0.1},
    {"id": "four-2", "who": "vo", "text": "Le four fait un drôle de bruit.", "pause": 0.1},
    {"id": "four-3", "who": "vo", "text": "L'aiguille est dans le rouge.", "pause": 0.1},
    {"id": "four-4", "who": "vo", "text": "Il va exploser.", "pause": 0.24},
    {"id": "four-5", "who": "vo", "text": "Et tout le village est sur la place, juste devant.", "pause": 0.1},
    {"id": "four-6", "who": "vo", "text": "Je dois prévenir tout le monde.", "pause": 0.07},
    {"id": "four-7", "who": "vo", "text": "Avec quinze mots.", "pause": 0.07},
    {"id": "four-8", "who": "vo", "text": "Maximum.", "pause": 0.28},
    {"id": "euh", "who": "leon", "text": "Euh…", "say": "Euuuh...", "paid": true, "pause": 0.17},
    {"id": "euh-2", "who": "vo", "text": "Non ! Le « euh », ça compte !", "say": "Non ! Le euh, ça compte !", "pause": 0.21},
    {"id": "choix-1", "who": "vo", "text": "« Mesdames et messieurs » ? Trois euros. Trop cher.", "pause": 0.14},
    {"id": "choix-2", "who": "vo", "text": "« Attention, le four va exploser » ? Cinq euros.", "pause": 0.07},
    {"id": "choix-3", "who": "vo", "text": "Et personne ne m'écoute.", "pause": 0.24},
    {"id": "idee-1", "who": "vo", "text": "Et là, j'ai une idée.", "pause": 0.1},
    {"id": "idee-2", "who": "vo", "text": "Dessiner dans la farine, c'est gratuit.", "pause": 0.14},
    {"id": "idee-3", "who": "vo", "text": "Sonner les cloches, c'est gratuit.", "pause": 0.77},
    {"id": "courez", "who": "leon", "text": "COUREZ !", "say": "Courez !", "paid": true, "pause": 0.07},
    {"id": "courez-echo", "who": "echo", "of": "courez", "text": "courez…", "repeats": 3, "gap": 0.38, "paid": true, "pause": 0.14},
    {"id": "echo-oubli", "who": "vo", "text": "J'avais oublié l'écho.", "pause": 0.28},
    {"id": "chute-1", "who": "vo", "text": "Tout le monde court.", "pause": 0.14},
    {"id": "chute-2", "who": "vo", "text": "Le four explose…", "pause": 0.63},
    {"id": "chute-3", "who": "vo", "text": "et il pleut des croissants sur tout le village.", "pause": 0.1},
    {"id": "merci-1", "who": "vo", "text": "Le maire s'approche. Ému. Il ouvre la bouche…", "pause": 0.21},
    {"id": "merci", "who": "maire", "text": "Merci.", "paid": true, "payer": "maire", "pause": 0.24},
    {"id": "merci-2", "who": "vo", "text": "Un euro. Le plus gros pourboire de l'histoire du village.", "pause": 0.21},
    {"id": "fin-1", "who": "vo", "text": "Il me reste dix euros.", "pause": 0.07},
    {"id": "fin-2", "who": "vo", "text": "Je les garde pour un truc important.", "pause": 0.35},
    {"id": "cta-1", "who": "vo", "text": "Et toi, tu dirais quoi avec quinze mots ?", "pause": 0.14},
    {"id": "cta-2", "who": "vo", "text": "Écris-le en commentaire.", "pause": 0.07},
    {"id": "cta-3", "who": "vo", "text": "Ici, c'est gratuit.", "pause": 0.84}
  ]
}

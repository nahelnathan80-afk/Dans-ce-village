.3}, {"text": "Gisèle,", "start": 19.32, "end": 19.62}, {"text": "78", "start": 19.64, "end": 19.94}, {"text": "ans.", "start": 19.96, "end": 20.26}]}, {"id": "gisele-2", "who": "vo", "text": "Elle campe depuis mardi.", "pause": 0.1, "start": 20.48, "end": 21.74, "words": [{"text": "Elle", "start": 20.48, "end": 20.78}, {"text": "campe", "start": 20.8, "end": 21.1}, {"text": "depuis", "start": 21.12, "end": 21.42}, {"text": "mardi.", "start": 21.44, "end": 21.74}]}, {"id": "gisele-3", "who": "vo", "text": "Avec son fauteuil, sa soupe, et un thermos de café.", "pause": 0.3, "start": 21.96, "end": 25.14, "words": [{"text": "Avec", "start": 21.96, "end": 22.26}, {"text": "son", "start": 22.28, "end": 22.58}, {"text": "fauteuil,", "start": 22.6, "end": 22.9}, {"text": "sa", "start": 22.92, "end": 23.22}, {"text": "soupe,", "start": 23.24, "end": 23.54}, {"text": "et", "start": 23.56, "end": 23.86}, {"text": "un", "start": 23.88, "end": 24.18}, {"text": "thermos", "start": 24.2, "end": 24.5}, {"text": "de", "start": 24.52, "end": 24.82}, {"text": "café.", "start": 24.84, "end": 25.14}]}, {"id": "maire-1", "who": "vo", "text": "Le maire a planté sa tente juste derrière.", "pause": 0.1, "start": 25.36, "end": 27.9, "words": [{"text": "Le", "start": 25.36, "end": 25.66}, {"text": "maire", "start": 25.68, "end": 25.98}, {"text": "a", "start": 26.0, "end": 26.3}, {"text": "planté", "start": 26.32, "end": 26.62}, {"text": "sa", "start": 26.64, "end": 26.94}, {"text": "tente", "start": 26.96, "end": 27.26}, {"text": "juste", "start": 27.28, "end": 27.58}, {"text": "derrière.", "start": 27.6, "end": 27.9}]}, {"id": "maire-2", "who": "vo", "text": "Officiellement, il « inspecte la file ».", "pause": 0.15, "start": 28.12, "end": 30.34, "words": [{"text": "Officiellement,", "start": 28.12, "end": 28.42}, {"text": "il", "start": 28.44, "end": 28.74}, {"text": "«", "start": 28.76, "end": 29.06}, {"text": "inspecte", "start": 29.08, "end": 29.38}, {"text": "la", "start": 29.4, "end": 29.7}, {"text": "file", "start": 29.72, "end": 30.02}, {"text": "».", "start": 30.04, "end": 30.34}]}, {"id": "maire-3", "who": "vo", "text": "Ça fait trois nuits qu'il l'inspecte. En pyjama.", "pause": 0.3, "start": 30.56, "end": 33.1, "words": [{"text": "Ça", "start": 30.56, "end": 30.86}, {"text": "fait", "start": 30.88, "end": 31.18}, {"text": "trois", "start": 31.2, "end": 31.5}, {"text": "nuits", "start": 31.52, "end": 31.82}, {"text": "qu'il", "start": 31.84, "end": 32.14}, {"text": "l'inspecte.", "start": 32.16, "end": 32.46}, {"text": "En", "start": 32.48, "end": 32.78}, {"text": "pyjama.", "start": 32.8, "end": 33.1}]}, {"id": "kevin-1", "who": "vo", "text": "Kevin, lui, a vendu sa place dans la file. 50 euros.", "say": "Kevin, lui, a vendu sa place dans la file. Cinquante euros.", "pause": 0.15, "start": 33.32, "end": 36.82, "words": [{"text": "Kevin,", "start": 33.32, "end": 33.62}, {"text": "lui,", "start": 33.64, "end": 33.94}, {"text": "a", "start": 33.96, "end": 34.26}, {"text": "vendu", "start": 34.28, "end": 34.58}, {"text": "sa", "start": 34.6, "end": 34.9}, {"text": "place", "start": 34.92, "end": 35.22}, {"text": "dans", "start": 35.24, "end": 35.54}, {"text": "la", "start": 35.56, "end": 35.86}, {"text": "file.", "start": 35.88, "end": 36.18}, {"text": "50", "start": 36.2, "end": 36.5}, {"text": "euros.", "start": 36.52, "end": 36.82}]}, {"id": "kevin-2", "who": "vo", "text": "Puis il l'a rachetée. 80 euros.", "say": "Puis il l'a rachetée. Quatre-vingts euros.", "pause": 0.15, "start": 37.04, "end": 38.94, "words": [{"text": "Puis", "start": 37.04, "end": 37.34}, {"text": "il", "start": 37.36, "end": 37.66}, {"text": "l'a", "start": 37.68, "end": 37.98}, {"text": "rachetée.", "start": 38.0, "end": 38.3}, {"text": "80", "start": 38.32, "end": 38.62}, {"text": "euros.", "start": 38.64, "end": 38.94}]}, {"id": "kevin-3", "who": "vo", "text": "Kevin a un business plan. Il ne le comprend pas, mais il en a un.", "pause": 0.35, "start": 39.16, "end": 43.94, "words": [{"text": "Kevin", "start": 39.16, "end": 39.46}, {"text": "a", "start": 39.48, "end": 39.78}, {"text": "un", "start": 39.8, "end": 40.1}, {"text": "business", "start": 40.12, "end": 40.42}, {"text": "plan.", "start": 40.44, "end": 40.74}, {"text": "Il", "start": 40.76, "end": 41.06}, {"text": "ne", "start": 41.08, "end": 41.38}, {"text": "le", "start": 41.4, "end": 41.7}, {"text": "comprend", "start": 41.72, "end": 42.02}, {"text": "pas,", "start": 42.04, "end": 42.34}, {"text": "mais", "start": 42.36, "end": 42.66}, {"text": "il", "start": 42.68, "end": 42.98}, {"text": "en", "start": 43.0, "end": 43.3}, {"text": "a", "start": 43.32, "end": 43.62}, {"text": "un.", "start": 43.64, "end": 43.94}]}, {"id": "jr-1", "who": "vo", "text": "Et puis, il y a Jean-Revente.", "pause": 0.12, "start": 44.16, "end": 46.06, "words": [{"text": "Et", "start": 44.16, "end": 44.46}, {"text": "puis,", "start": 44.48, "end": 44.78}, {"text": "il", "start": 44.8, "end": 45.1}, {"text": "y", "start": 45.12, "end": 45.42}, {"text": "a", "start": 45.44, "end": 45.74}, {"text": "Jean-Revente.", "start": 45.76, "end": 46.06}]}, {"id": "jr-2", "who": "vo", "text": "Jean-Revente n'aime pas les cartes. Il aime les marges.", "pause": 0.2, "start": 46.28, "end": 49.14, "words": [{"text": "Jean-Revente", "start": 46.28, "end": 46.58}, {"text": "n'aime", "start": 46.6, "end": 46.9}, {"text": "pas", "start": 46.92, "end": 47.22}, {"text": "les", "start": 47.24, "end": 47.54}, {"text": "cartes.", "start": 47.56, "end": 47.86}, {"text": "Il", "start": 47.88, "end": 48.18}, {"text": "aime", "start": 48.2, "end": 48.5}, {"text": "les", "start": 48.52, "end": 48.82}, {"text": "marges.", "start": 48.84, "end": 49.14}]}, {"id": "jr-3", "who": "vo", "text": "Il est venu avec ses cousins. 47 cousins.", "say": "Il est venu avec ses cousins. Quarante-sept cousins.", "pause": 0.15, "start": 49.36, "end": 51.9, "words": [{"text": "Il", "start": 49.36, "end": 49.66}, {"text": "est", "start": 49.68, "end": 49.98}, {"text": "venu", "start": 50.0, "end": 50.3}, {"text": "avec", "start": 50.32, "end": 50.62}, {"text": "ses", "start": 50.64, "end": 50.94}, {"text": "cousins.", "start": 50.96, "end": 51.26}, {"text": "47", "start": 51.28, "end": 51.58}, {"text": "cousins.", "start": 51.6, "end": 51.9}]}, {"id": "jr-4", "who": "vo", "text": "Tous avec une moustache. Un peu de travers.", "pause": 0.35, "start": 52.12, "end": 54.66, "words": [{"text": "Tous", "start": 52.12, "end": 52.42}, {"text": "avec", "start": 52.44, "end": 52.74}, {"text": "une", "start": 52.76, "end": 53.06}, {"text": "moustache.", "start": 53.08, "end": 53.38}, {"text": "Un", "start": 53.4, "end": 53.7}, {"text": "peu", "start": 53.72, "end": 54.02}, {"text": "de", "start": 54.04, "end": 54.34}, {"text": "travers.", "start": 54.36, "end": 54.66}]}, {"id": "ouv-1", "who": "vo", "text": "Jeudi, neuf heures pile. La vendeuse ouvre la porte.", "pause": 0.15, "start": 54.88, "end": 57.74, "words": [{"text": "Jeudi,", "start": 54.88, "end": 55.18}, {"text": "neuf", "start": 55.2, "end": 55.5}, {"text": "heures", "start": 55.52, "end": 55.82}, {"text": "pile.", "start": 55.84, "end": 56.14}, {"text": "La", "start": 56.16, "end": 56.46}, {"text": "vendeuse", "start": 56.48, "end": 56.78}, {"text": "ouvre", "start": 56.8, "end": 57.1}, {"text": "la", "start": 57.12, "end": 57.42}, {"text": "porte.", "start": 57.44, "end": 57.74}]}, {"id": "ouv-2", "who": "vendeuse", "text": "Un coffret par personne !", "pause": 0.2, "start": 57.96, "end": 59.54, "words": [{"text": "Un", "start": 57.96, "end": 58.26}, {"text": "coffret", "start": 58.28, "end": 58.58}, {"text": "par", "start": 58.6, "end": 58.9}, {"text": "personne", "start": 58.92, "end": 59.22}, {"text": "!", "start": 59.24, "end": 59.54}]}, {"id": "ouv-3", "who": "vo", "text": "Ça tombe bien. Il n'y en a qu'un.", "pause": 0.3, "start": 59.76, "end": 62.3, "words": [{"text": "Ça", "start": 59.76, "end": 60.06}, {"text": "tombe", "start": 60.08, "end": 60.38}, {"text": "bien.", "start": 60.4, "end": 60.7}, {"text": "Il", "start": 60.72, "end": 61.02}, {"text": "n'y", "start": 61.04, "end": 61.34}, {"text": "en", "start": 61.36, "end": 61.66}, {"text": "a", "start": 61.68, "end": 61.98}, {"text": "qu'un.", "start": 62.0, "end": 62.3}]}, {"id": "ruee-1", "who": "vo", "text": "Les 47 cousins foncent.", "say": "Les quarante-sept cousins foncent.", "pause": 0.1, "start": 62.52, "end": 63.78, "words": [{"text": "Les", "start": 62.52, "end": 62.82}, {"text": "47", "start": 62.84, "end": 63.14}, {"text": "cousins", "start": 63.16, "end": 63.46}, {"text": "foncent.", "start": 63.48, "end": 63.78}]}, {"id": "ruee-2", "who": "vo", "text": "Gisèle aussi. Avec le fauteuil.", "pause": 0.4, "start": 64.0, "end": 65.58, "words": [{"text": "Gisèle", "start": 64.0, "end": 64.3}, {"text": "aussi.", "start": 64.32, "end": 64.62}, {"text": "Avec", "start": 64.64, "end": 64.94}, {"text": "le", "start": 64.96, "end": 65.26}, {"text": "fauteuil.", "start": 65.28, "end": 65.58}]}, {"id": "climax-1", "who": "vo", "text": "Et moi ? J'étais déjà à l'intérieur depuis cinq heures du matin.", "pause": 0.15, "start": 65.8, "end": 69.62, "words": [{"text": "Et", "start": 65.8, "end": 66.1}, {"text": "moi", "start": 66.12, "end": 66.42}, {"text": "?", "start": 66.44, "end": 66.74}, {"text": "J'étais", "start": 66.76, "end": 67.06}, {"text": "déjà", "start": 67.08, "end": 67.38}, {"text": "à", "start": 67.4, "end": 67.7}, {"text": "l'intérieur", "start": 67.72, "end": 68.02}, {"text": "depuis", "start": 68.04, "end": 68.34}, {"text": "cinq", "start": 68.36, "end": 68.66}, {"text": "heures", "start": 68.68, "end": 68.98}, {"text": "du", "start": 69.0, "end": 69.3}, {"text": "matin.", "start": 69.32, "end": 69.62}]}, {"id": "climax-2", "who": "vo", "text": "Je livre les croissants du magasin. J'avais les clés.", "pause": 0.2, "start": 69.84, "end": 72.7, "words": [{"text": "Je", "start": 69.84, "end": 70.14}, {"text": "livre", "start": 70.16, "end": 70.46}, {"text": "les", "start": 70.48, "end": 70.78}, {"text": "croissants", "start": 70.8, "end": 71.1}, {"text": "du", "start": 71.12, "end": 71.42}, {"text": "magasin.", "start": 71.44, "end": 71.74}, {"text": "J'avais", "start": 71.76, "end": 72.06}, {"text": "les", "start": 72.08, "end": 72.38}, {"text": "clés.", "start": 72.4, "end": 72.7}]}, {"id": "climax-3", "who": "vo", "text": "J'ai acheté le coffret… et je l'ai donné à Gisèle.", "pause": 0.2, "start": 72.92, "end": 76.1, "words": [{"text": "J'ai", "start": 72.92, "end": 73.22}, {"text": "acheté", "start": 73.24, "end": 73.54}, {"text": "le", "start": 73.56, "end": 73.86}, {"text": "coffret…", "start": 73.88, "end": 74.18}, {"text": "et", "start": 74.2, "end": 74.5}, {"text": "je", "start": 74.52, "end": 74.82}, {"text": "l'ai", "start": 74.84, "end": 75.14}, {"text": "donné", "start": 75.16, "end": 75.46}, {"text": "à", "start": 75.48, "end": 75.78}, {"text": "Gisèle.", "start": 75.8, "end": 76.1}]}, {"id": "merci", "who": "gisele", "text": "Merci, mon petit !", "pause": 0.25, "start": 76.32, "end": 77.58, "words": [{"text": "Merci,", "start": 76.32, "end": 76.62}, {"text": "mon", "start": 76.64, "end": 76.94}, {"text": "petit", "start": 76.96, "end": 77.26}, {"text": "!", "start": 77.28, "end": 77.58}]}, {"id": "climax-4", "who": "vo", "text": "Jean-Revente lui en a proposé 2 000 euros.", "say": "Jean-Revente lui en a proposé deux mille euros.", "pause": 0.15, "start": 77.8, "end": 80.34, "words": [{"text": "Jean-Revente", "start": 77.8, "end": 78.1}, {"text": "lui", "start": 78.12, "end": 78.42}, {"text": "en", "start": 78.44, "end": 78.74}, {"text": "a", "start": 78.76, "end": 79.06}, {"text": "proposé", "start": 79.08, "end": 79.38}, {"text": "2", "start": 79.4, "end": 79.7}, {"text": "000", "start": 79.72, "end": 80.02}, {"text": "euros.", "start": 80.04, "end": 80.34}]}, {"id": "climax-5", "who": "vo", "text": "Elle a dit non. C'était pour son petit-fils.", "pause": 0.4, "start": 80.56, "end": 83.1, "words": [{"text": "Elle", "start": 80.56, "end": 80.86}, {"text": "a", "start": 80.88, "end": 81.18}, {"text": "dit", "start": 81.2, "end": 81.5}, {"text": "non.", "start": 81.52, "end": 81.82}, {"text": "C'était", "start": 81.84, "end": 82.14}, {"text": "pour", "start": 82.16, "end": 82.46}, {"text": "son", "start": 82.48, "end": 82.78}, {"text": "petit-fils.", "start": 82.8, "end": 83.1}]}, {"id": "chute-1", "who": "vo", "text": "Le lendemain, l'éditeur annonce une réédition. En quantité illimitée.", "pause": 0.3, "start": 83.32, "end": 86.18, "words": [{"text": "Le", "start": 83.32, "end": 83.62}, {"text": "lendemain,", "start": 83.64, "end": 83.94}, {"text": "l'éditeur", "start": 83.96, "end": 84.26}, {"text": "annonce", "start": 84.28, "end": 84.58}, {"text": "une", "start": 84.6, "end": 84.9}, {"text": "réédition.", "start": 84.92, "end": 85.22}, {"text": "En", "start": 85.24, "end": 85.54}, {"text": "quantité", "start": 85.56, "end": 85.86}, {"text": "illimitée.", "start": 85.88, "end": 86.18}]}, {"id": "chute-2", "who": "vo", "text": "Ce matin, Jean-Revente dort à nouveau devant le magasin.", "pause": 0.2, "start": 86.4, "end": 89.26, "words": [{"text": "Ce", "start": 86.4, "end": 86.7}, {"text": "matin,", "start": 86.72, "end": 87.02}, {"text": "Jean-Revente", "start": 87.04, "end": 87.34}, {"text": "dort", "start": 87.36, "end": 87.66}, {"text": "à", "start": 87.68, "end": 87.98}, {"text": "nouveau", "start": 88.0, "end": 88.3}, {"text": "devant", "start": 88.32, "end": 88.62}, {"text": "le", "start": 88.64, "end": 88.94}, {"text": "magasin.", "start": 88.96, "end": 89.26}]}, {"id": "chute-3", "who": "vo", "text": "Mais cette fois… pour se faire rembourser 47 coffrets.", "say": "Mais cette fois... pour se faire rembourser quarante-sept coffrets.", "pause": 0.5, "start": 89.48, "end": 92.34, "words": [{"text": "Mais", "start": 89.48, "end": 89.78}, {"text": "cette", "start": 89.8, "end": 90.1}, {"text": "fois…", "start": 90.12, "end": 90.42}, {"text": 
{"duration": 98.9, "lines": [{"id": "hook-1", "who": "vo", "text": "Dans mon village, il y a 412 habitants…", "say": "Dans mon village, il y a quatre cent douze habitants...", "pause": 0.1, "start": 0.2, "end": 2.74, "words": [{"text": "Dans", "start": 0.2, "end": 0.5}, {"text": "mon", "start": 0.52, "end": 0.82}, {"text": "village,", "start": 0.84, "end": 1.14}, {"text": "il", "start": 1.16, "end": 1.46}, {"text": "y", "start": 1.48, "end": 1.78}, {"text": "a", "start": 1.8, "end": 2.1}, {"text": "412", "start": 2.12, "end": 2.42}, {"text": "habitants…", "start": 2.44, "end": 2.74}]}, {"id": "hook-2", "who": "vo", "text": "et 459 personnes qui dorment devant le magasin de jouets.", "say": "et quatre cent cinquante-neuf personnes qui dorment devant le magasin de jouets.", "pause": 0.3, "start": 2.96, "end": 6.14, "words": [{"text": "et", "start": 2.96, "end": 3.26}, {"text": "459", "start": 3.28, "end": 3.58}, {"text": "personnes", "start": 3.6, "end": 3.9}, {"text": "qui", "start": 3.92, "end": 4.22}, {"text": "dorment", "start": 4.24, "end": 4.54}, {"text": "devant", "start": 4.56, "end": 4.86}, {"text": "le", "start": 4.88, "end": 5.18}, {"text": "magasin", "start": 5.2, "end": 5.5}, {"text": "de", "start": 5.52, "end": 5.82}, {"text": "jouets.", "start": 5.84, "end": 6.14}]}, {"id": "coffret-1", "who": "vo", "text": "Tout ça pour un coffret.", "pause": 0.12, "start": 6.36, "end": 7.94, "words": [{"text": "Tout", "start": 6.36, "end": 6.66}, {"text": "ça", "start": 6.68, "end": 6.98}, {"text": "pour", "start": 7.0, "end": 7.3}, {"text": "un", "start": 7.32, "end": 7.62}, {"text": "coffret.", "start": 7.64, "end": 7.94}]}, {"id": "coffret-2", "who": "vo", "text": "Le coffret Ultra Premium des 30 ans des Bestioles Mystiques.", "say": "Le coffret Ultra Premium des trente ans des Bestioles Mystiques.", "pause": 0.15, "start": 8.16, "end": 11.34, "words": [{"text": "Le", "start": 8.16, "end": 8.46}, {"text": "coffret", "start": 8.48, "end": 8.78}, {"text": "Ultra", "s